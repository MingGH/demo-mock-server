apiVersion: v1
kind: Secret
metadata:
  name: grafana-observability-secret
  namespace: runnable-run
type: Opaque
stringData:
  # Grafana Loki 实例 ID
  loki-user: "<GRAFANA_LOKI_USER>"
  # logs:write Access Policy token
  loki-token: "<GRAFANA_LOKI_TOKEN>"
  # 完整值：Basic base64(<OTLP实例ID>:<metrics:write token>)
  otlp-authorization: "<GRAFANA_OTLP_AUTHORIZATION>"
